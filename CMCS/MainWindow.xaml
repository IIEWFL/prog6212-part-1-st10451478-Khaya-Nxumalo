<Window x:Class="CMCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lecturer Claim Submission" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input Section -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="MonthInput" Width="100" Margin="5" Text="Month" />
            <TextBox x:Name="HoursInput" Width="100" Margin="5" Text="Hours Worked" />
            <TextBox x:Name="RateInput" Width="100" Margin="5" Text="Hourly Rate" />
            <Button Content="Submit Claim" Width="120" Margin="5" Click="SubmitClaim_Click" />
        </StackPanel>

        <!-- DataGrid Section -->
        <DataGrid x:Name="ClaimsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Month" Binding="{Binding Month}" />
                <DataGridTextColumn Header="Hours Worked" Binding="{Binding HoursWorked}" />
                <DataGridTextColumn Header="Hourly Rate" Binding="{Binding HourlyRate}" />
                <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount}" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
